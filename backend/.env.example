# Local SQLite (default for local dev — no DATABASE_URL needed):
#   The app defaults to sqlite:///./wcbet.db when DATABASE_URL is not set.
#
# Supabase Postgres (production / GitHub Actions / Vercel):
#   Set DATABASE_URL to your Supabase connection string (Transaction pooler
#   on port 6543 recommended for serverless; direct on 5432 for the refresh job).
# DATABASE_URL=postgresql+psycopg://postgres:[PASSWORD]@[HOST]:5432/postgres
#
# Local Postgres (alternative local dev):
DATABASE_URL=postgresql+psycopg://wc:wc@localhost:5432/wcbet

ODDS_API_KEY=
API_FOOTBALL_KEY=
ODDS_API_BASE=https://api.the-odds-api.com/v4
API_FOOTBALL_BASE=https://v3.football.api-sports.io
MODEL_SIMS=50000
MODEL_DECAY_HALFLIFE_DAYS=540
